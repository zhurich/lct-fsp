# Скопируйте в .env и задайте значения перед `docker compose up` или локальным запуском бэкенда.

# Секрет подписи токенов, не короче 32 символов: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Обязателен: без него (или с примером из старых версий) приложение не стартует.
SECRET_KEY=
POSTGRES_PASSWORD=fsp

# Внешний адрес сайта — подставляется в ссылки из писем.
PUBLIC_URL=http://localhost:8080
# true, если сайт открыт по HTTPS.
COOKIE_SECURE=false

# Стенд проверки: регистрация без подтверждения почты, кандидат может сбросить свои попытки теста и пройти
# его заново. На рабочем стенде оставьте false.
DEMO_MODE=false

# По умолчанию письма уходят в Mailpit (http://localhost:8025). Для реальной почты укажите свой SMTP.
# SMTP_HOST=
# SMTP_PORT=
